{
  "name": "w-a",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace apps/backend",
    "mobile:start": "npm run start --workspace apps/mobile",
    "web:dev": "npm run dev --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/backend && tsc --noEmit -p apps/mobile && tsc --noEmit -p packages/shared && npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/backend"
  },
  "devDependencies": {
    "expo": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@types/react": "~19.2.2"
  }
}

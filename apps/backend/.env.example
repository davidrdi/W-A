# Nunca commitear .env real. Estas variables solo viven en el backend.

PORT=3000

# Anthropic API (Claude) — razonamiento de recomendaciones y NLU del cuestionario
ANTHROPIC_API_KEY=

# Supabase (Postgres + PostGIS + Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AEMET OpenData — no imprescindible en el MVP, se añade en v2
AEMET_API_KEY=

# Overpass API (OpenStreetMap) — endpoint público por defecto, sustituible por instancia propia
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Secreto compartido para POST /internal/notify-favorites (V2). Lo llama un
# scheduler externo (cron/Supabase scheduled function), nunca el móvil.
# Genera algo largo y aleatorio, ej: openssl rand -hex 32
INTERNAL_JOB_SECRET=

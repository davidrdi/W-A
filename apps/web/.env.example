# Copiar a .env.local y rellenar si el backend no corre en localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mismo proyecto Supabase que usa Trebo (davidrdi) — Project Settings > API.
# Son valores públicos por diseño (van al bundle del navegador, protegidos
# por RLS, no por ser secretos).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

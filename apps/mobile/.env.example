# Copiar a .env y rellenar. Expo solo expone al bundle las variables con
# prefijo EXPO_PUBLIC_ — nunca pongas aquí una clave que no deba ser
# pública (la anon key de Supabase SÍ es pública por diseño, protegida por
# Row Level Security; la service role key NUNCA va aquí, solo en el backend).

EXPO_PUBLIC_API_URL=http://localhost:3000

# Ver README > "Crear el proyecto Supabase desde cero" para obtenerlas.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
